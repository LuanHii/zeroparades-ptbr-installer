<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZeroParadesPTBR.MainWindow"
        Title="Zero Parades — Tradução PT-BR"
        Width="660"
        Height="520"
        MinWidth="580"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#121417">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

    <!-- Cabeçalho -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Zero Parades: For Dead Spies — Tradução PT-BR"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="#F3F4F6" />
      <TextBlock Text="Instalador local de tradução (substitui o slot Deutsch/Alemão sem modificar saves)."
                 FontSize="13"
                 Foreground="#9CA3AF" />
    </StackPanel>

    <!-- Cartão de caminho e status -->
    <Border Grid.Row="1"
            Background="#1B1F24"
            BorderBrush="#2A3038"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
            <TextBlock Text="Bundle do jogo" FontSize="12" Foreground="#9CA3AF" />
            <TextBox x:Name="BundlePathBox"
                     IsReadOnly="True"
                     Watermark="Jogo não encontrado automaticamente..."
                     FontSize="12" />
          </StackPanel>
          <Button x:Name="BrowseButton"
                  Grid.Column="1"
                  Content="Procurar..."
                  VerticalAlignment="Bottom"
                  Click="OnBrowseClick" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="PoStatusText"
                     Grid.Column="0"
                     Text="Verificando my_translation.po..."
                     FontSize="12"
                     Foreground="#D1D5DB"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" />
          <TextBlock x:Name="BackupStatusText"
                     Grid.Column="1"
                     Text=""
                     FontSize="12"
                     Foreground="#9CA3AF"
                     VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Log e progresso -->
    <Border Grid.Row="2"
            Background="#16191D"
            BorderBrush="#2A3038"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,16">
      <Grid RowDefinitions="*,Auto">
        <TextBox x:Name="LogBox"
                 Grid.Row="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, Monospace"
                 FontSize="12"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#D1D5DB" />
        <ProgressBar x:Name="Progress"
                     Grid.Row="1"
                     Height="4"
                     Margin="0,10,0,0"
                     IsIndeterminate="False"
                     IsVisible="False" />
      </Grid>
    </Border>

    <!-- Ações -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
      <TextBlock Grid.Column="0"
                 Text="Após instalar, abra o jogo em Settings → Language → Deutsch."
                 FontSize="12"
                 Foreground="#9CA3AF"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Margin="0,0,10,0" />
      <Button x:Name="RestoreButton"
              Grid.Column="1"
              Content="Restaurar Original"
              Padding="14,8"
              Margin="0,0,10,0"
              Click="OnRestoreClick" />
      <Button x:Name="InstallButton"
              Grid.Column="2"
              Content="Instalar Tradução"
              Classes="accent"
              Padding="18,8"
              FontWeight="SemiBold"
              Click="OnInstallClick" />
    </Grid>

  </Grid>
</Window>
